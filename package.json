{
  "name": "nudge",
  "productName": "Gani's Work",
  "version": "1.0.0",
  "description": "A calm, keyboard-first task list for designers.",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "web": "vite",
    "build": "vite build",
    "build:demo": "vite build --outDir demo",
    "start": "vite build && electron .",
    "icon": "electron scripts/make-icon.cjs",
    "smoke": "vite build && electron scripts/smoke.cjs",
    "dist": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0"
  },
  "author": "Gani's Work",
  "build": {
    "appId": "app.nudge.tasks",
    "productName": "Gani's Work",
    "copyright": "Personal use",
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signtoolOptions": {
        "sign": "./scripts/no-sign.cjs"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gani's Work"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    }
  }
}
